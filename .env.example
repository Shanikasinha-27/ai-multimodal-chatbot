# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (MySQL with automatic SQLite fallback)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=emotional_chatbot_db

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Emotional Support Guardrails
CRISIS_HELPLINE_PRIMARY=988 (Suicide & Crisis Lifeline - Call/Text 24/7)
CRISIS_HELPLINE_TEXT=Text HOME to 741741 (Crisis Text Line)
ENABLE_STRICT_GUARDRAILS=true
